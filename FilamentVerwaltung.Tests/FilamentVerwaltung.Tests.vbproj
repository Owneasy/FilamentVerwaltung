<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FilamentVerwaltung.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <!-- Tests für Kern und Server (ohne die Windows-App); laufen auch unter Linux in GitHub Actions vor dem Bau des Server-Images. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FilamentVerwaltung.Kern\FilamentVerwaltung.Kern.vbproj" />
    <ProjectReference Include="..\FilamentVerwaltung.Server\FilamentVerwaltung.Server.vbproj" />
  </ItemGroup>

</Project>