Imports System.IO
Imports Microsoft.Data.Sqlite

''' <summary>Frische Datenbank je Test (eigener Ordner im Temp-Verzeichnis) und kleine Helfer.</summary>
Public Module TestHilfen

    Public Function NeuerOrdner() As String
        Dim ordner = Path.Combine(Path.GetTempPath(), "fv-test-" & Guid.NewGuid().ToString("N"))
        Directory.CreateDirectory(ordner)
        Return ordner
    End Function

    Public Function NeueDatenbank() As Datenbank
        Return New Datenbank(Path.Combine(NeuerOrdner(), "filament.db"))
    End Function

    Public Function Spule(db As Datenbank, code As String, Optional rest As Integer = 1000, Optional gewicht As Integer = 1000,
                          Optional preis As Decimal = 20D, Optional material As String = "PLA", Optional farbe As String = "Schwarz",
                          Optional hersteller As String = "Sunlu") As Filament
        Dim f As New Filament With {.Code = code, .Hersteller = hersteller, .Material = material, .Farbe = farbe,
                                    .Gewicht = gewicht, .Restgewicht = rest, .Preis = preis}
        db.Speichern(f)
        Return f
    End Function

    Public Function Rest(db As Datenbank, id As Long) As Integer
        Return db.AlleLaden().First(Function(f) f.Id = id).Restgewicht
    End Function

    ''' <summary>Direkter SQL-Befehl (z. B. um ein Datum in die Vergangenheit zu setzen oder eine alte Datenbank nachzubauen).</summary>
    Public Sub Sql(db As Datenbank, befehl As String)
        SqliteConnection.ClearAllPools()
        Using c As New SqliteConnection($"Data Source={db.Ort};Pooling=False")
            c.Open()
            Using cmd = c.CreateCommand()
                cmd.CommandText = befehl
                cmd.ExecuteNonQuery()
            End Using
        End Using
    End Sub

    ''' <summary>Kleine druckfertige Datei (G-Code mit Slicer-Angaben) zum Importieren.</summary>
    Public Function GcodeDatei(name As String, Optional gramm As Double = 25) As String
        Dim pfad = Path.Combine(NeuerOrdner(), name)
        File.WriteAllText(pfad, $"; generated by PrusaSlicer 2.8.0{vbLf}G1 X0 Y0{vbLf}; filament used [g] = {gramm.ToString(Globalization.CultureInfo.InvariantCulture)}{vbLf}; estimated printing time (normal mode) = 1h 2m 3s{vbLf}")
        Return pfad
    End Function

End Module
