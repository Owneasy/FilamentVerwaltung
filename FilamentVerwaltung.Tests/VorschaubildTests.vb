Imports System.IO
Imports System.IO.Compression
Imports Xunit

''' <summary>Vorschaubilder aus 3MF und G-Code, Zwischenspeicher und Weg über den Server.</summary>
Public Class VorschaubildTests

    ''' <summary>Kleinstes gültiges PNG (1×1 Pixel).</summary>
    Friend Shared ReadOnly Png As Byte() = Convert.FromBase64String("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==")

    Friend Shared Function DreiMfMitBild(name As String) As String
        Dim pfad = Path.Combine(NeuerOrdner(), name)
        Using zip = ZipFile.Open(pfad, ZipArchiveMode.Create)
            Using s = zip.CreateEntry("Metadata/plate_1.png").Open()
                s.Write(Png)
            End Using
            Using w As New StreamWriter(zip.CreateEntry("3D/3dmodel.model").Open())
                w.Write("<model/>")
            End Using
        End Using
        Return pfad
    End Function

    Friend Shared Function GcodeMitBild(name As String) As String
        Dim pfad = Path.Combine(NeuerOrdner(), name)
        Dim b64 = Convert.ToBase64String(Png)
        File.WriteAllText(pfad, $"; generated by PrusaSlicer{vbLf}; thumbnail begin 16x16 {b64.Length}{vbLf}; {b64.Substring(0, 40)}{vbLf}; {b64.Substring(40)}{vbLf}; thumbnail end{vbLf}G1 X0{vbLf}; filament used [g] = 12.5{vbLf}")
        Return pfad
    End Function

    <Fact>
    Public Sub Bild_aus_3MF_und_GCode_kein_Bild_bei_STL()
        Assert.Equal(Png, DateiAnalyse.VorschaubildLesen(DreiMfMitBild("teil.3mf")))
        Assert.Equal(Png, DateiAnalyse.VorschaubildLesen(GcodeMitBild("teil.gcode")))
        Dim stl = Path.Combine(NeuerOrdner(), "teil.stl")
        File.WriteAllText(stl, "solid x" & vbLf & "endsolid x")
        Assert.Null(DateiAnalyse.VorschaubildLesen(stl))
    End Sub

    <Fact>
    Public Sub Zwischenspeicher_merkt_sich_Bild_und_keins()
        Dim db = NeueDatenbank()
        Dim mit = db.DateiImportieren(GcodeMitBild("mit.gcode"))
        Dim ohne = db.DateiImportieren(GcodeDatei("ohne.gcode"))
        Assert.Equal(Png, db.DateiVorschaubild(mit))
        Assert.Null(db.DateiVorschaubild(ohne))
        ' Zweiter Abruf kommt aus dem Zwischenspeicher – auch wenn die Datei inzwischen fehlt
        File.Delete(db.DateiPfad(mit))
        Assert.Equal(Png, db.DateiVorschaubild(mit))
        db.DateiLoeschen(mit)
        Assert.False(File.Exists(Path.Combine(Path.GetDirectoryName(db.Ort), "Vorschaubilder", $"{mit.Id}.bild")))
    End Sub

End Class
