<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Server für den Betrieb im Docker-Container (z. B. auf Unraid). Daten liegen in FILAMENT_DATEN (Standard: /data). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FilamentVerwaltung</RootNamespace>
    <AssemblyName>FilamentVerwaltung.Server</AssemblyName>
    <StartupObject>FilamentVerwaltung.ServerProgramm</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Version>0.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FilamentVerwaltung.Kern\FilamentVerwaltung.Kern.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
