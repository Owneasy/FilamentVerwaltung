<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gemeinsamer Teil für App und Server: Modelle, Datenbank, Drucker-Anbindung, Dateianalyse. Ohne Windows-Abhängigkeiten. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FilamentVerwaltung</RootNamespace>
    <AssemblyName>FilamentVerwaltung.Kern</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="54.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

</Project>
